# Copy this file to .env and fill in your values.

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=abc123
DB_NAME=campusconnect_ai

# --- Google Gemini (optional: the app works without it using built-in fallbacks) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Default admin account created on first run ---
ADMIN_NAME=CampusConnect Admin
ADMIN_EMAIL=admin@campusconnect.ai
ADMIN_PASSWORD=Admin@12345
